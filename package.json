{
  "name": "cnc-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run sync:js-dos && vite",
    "build": "npm run sync:js-dos && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "sync:js-dos": "node scripts/sync-js-dos.mjs",
    "postinstall": "node scripts/sync-js-dos.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "js-dos": "8.4.1"
  },
  "description": "Play Command & Conquer: Tiberian Dawn and Red Alert in the browser, with your own game files.",
  "license": "GPL-3.0-or-later"
}
